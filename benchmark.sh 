#!/bin/bash

# Benchmark script for Game of Life implementations
# Measures performance across different thread counts

echo "================================="
echo "Game of Life Performance Benchmark"
echo "================================="
echo ""

SEED=12345
SIZE=500
ITERS=200
PROB=0.2
RUNS=3

# Function to run benchmark
run_benchmark() {
    local impl=$1
    local threads=$2
    local display=$3
    
    local total_time=0
    
    for run in $(seq 1 $RUNS); do
        # Capture timing output
        if [ "$display" == "yes" ]; then
            time_output=$(./$impl -n $SIZE -i $ITERS -t $threads -s $SEED -p $PROB 2>&1 | grep "Running time")
        else
            time_output=$(./$impl -n $SIZE -i $ITERS -t $threads -s $SEED -p $PROB -d 2>&1 | grep "Running time")
        fi
        
        # Extract time value
        time_val=$(echo "$time_output" | awk '{print $6}')
        total_time=$(echo "$total_time + $time_val" | bc)
    done
    
    # Calculate average
    avg_time=$(echo "scale=2; $total_time / $RUNS" | bc)
    echo "$avg_time"
}

# Benchmark OpenMP
benchmark_openmp() {
    echo "--- OpenMP Implementation ---"
    cd OpenMP || exit 1
    
    if [ ! -f life ]; then
        echo "ERROR: life executable not found. Run 'make' first."
        cd ..
        return 1
    fi
    
    echo ""
    echo "Configuration: ${SIZE}x${SIZE} grid, $ITERS iterations, probability=$PROB"
    echo "Running $RUNS trials per configuration..."
    echo ""
    
    echo "Results with display DISABLED:"
    echo "Threads | Avg Time (s) | Speedup | Efficiency"
    echo "--------|--------------|---------|------------"
    
    # Baseline with 1 thread
    time_1=$(run_benchmark "life" 1 "no")
    echo "   1    |    $time_1    |  1.00x  |   100%"
    
    # Test with multiple threads
    for threads in 2 4 8 16; do
        time_n=$(run_benchmark "life" $threads "no")
        speedup=$(echo "scale=2; $time_1 / $time_n" | bc)
        efficiency=$(echo "scale=1; ($speedup / $threads) * 100" | bc)
        printf "%4d    |   %6.2f   | %5.2fx  |  %5.1f%%\n" $threads $time_n $speedup $efficiency
    done
    
    echo ""
    echo "Results with display ENABLED:"
    echo "Threads | Avg Time (s) | Overhead"
    echo "--------|--------------|----------"
    
    for threads in 2 4 8; do
        time_display=$(run_benchmark "life" $threads "yes")
        time_no_display=$(run_benchmark "life" $threads "no")
        overhead=$(echo "scale=1; (($time_display - $time_no_display) / $time_no_display) * 100" | bc)
        printf "%4d    |   %6.2f   |  %5.1f%%\n" $threads $time_display $overhead
    done
    
    cd ..
}

