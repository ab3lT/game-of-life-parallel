# Generate CSV for plotting
generate_csv() {
    echo ""
    echo "Generating CSV data for plotting..."
    
    echo "threads,openmp_time,pthreads_time" > benchmark_results.csv
    
    cd OpenMP
    for threads in 1 2 4 8 16; do
        omp_time=$(run_benchmark "life" $threads "no")
        cd ../Pthreads
        pthread_time=$(run_benchmark "life" $threads "no")
        cd ../OpenMP
        echo "$threads,$omp_time,$pthread_time" >> ../benchmark_results.csv
    done
    cd ..
    
    echo "Results saved to benchmark_results.csv"
}

# Main execution
echo "System Information:"
echo "  CPU: $(lscpu | grep "Model name" | cut -d: -f2 | xargs)"
echo "  Cores: $(nproc)"
echo "  Date: $(date)"
echo ""

benchmark_openmp
benchmark_pthreads
generate_csv

echo ""
echo "================================="
echo "Benchmark Complete"
echo "================================="
echo ""
echo "To visualize results, you can use:"
echo "  - Import benchmark_results.csv into Excel/LibreOffice"
echo "  - Use gnuplot with the provided data"
echo "  - Use Python matplotlib"