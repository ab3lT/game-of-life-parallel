/* **********************************************************
 * Parallel OpenMP Code : Conway's Game of Life
 * 
 * Task + Data Parallelism Implementation
 * - One thread handles plotting (task parallelism)
 * - Remaining threads handle computation (data parallelism)
 * - Uses 1D domain decomposition
 *
 * Author: Abel Tadesse
 * Date: November 2025
 *************************************************************/

#include <stdlib.h>
#include <stdio.h>
#include <math.h>
#include <assert.h>
#include <string.h>
#include <omp.h>

#define MATCH(s) (!strcmp(argv[ac], (s)))

int MeshPlot(int t, int m, int n, char **mesh);

double real_rand();
int seed_rand(long sd);

static char **currWorld=NULL, **nextWorld=NULL, **tmesh=NULL;
static int maxiter = 200;
static int population[2] = {0,0};

int nx = 100;
int ny = 100;

static int w_update = 0;
static int w_plot = 1;

double getTime();
extern FILE *gnu;

/* Synchronization variables */
static int plot_ready = 0;
static int compute_done = 0;
static int current_iter = 0;
omp_lock_t plot_lock;

int main(int argc,char **argv)
{
    int i,j,ac;
    
    float prob = 0.5;
    long seedVal = 0;
    int game = 0;
    int s_step = 0;
    int numthreads = 1;
    int disable_display = 0;
    
    for(ac=1;ac<argc;ac++)
    {
        if(MATCH("-n")) {nx = atoi(argv[++ac]);}
        else if(MATCH("-i")) {maxiter = atoi(argv[++ac]);}
        else if(MATCH("-t")) {numthreads = atoi(argv[++ac]);}
        else if(MATCH("-p")) {prob = atof(argv[++ac]);}
        else if(MATCH("-s")) {seedVal = atof(argv[++ac]);}
        else if(MATCH("-step")) {s_step = 1;}
        else if(MATCH("-d")) {disable_display = 1;}
        else if(MATCH("-g")) {game = atoi(argv[++ac]);}
        else {
            printf("Usage: %s [-n <meshpoints>] [-i <iterations>] [-s seed] [-p prob] [-t numthreads] [-step] [-g <game #>] [-d]\n",argv[0]);
            return(-1);
        }
    }

    omp_set_num_threads(numthreads);
    int rs = seed_rand(seedVal);
    
    nx = nx+2;
    ny = nx;
    
    /* Allocate memory */
    currWorld = (char**)malloc(sizeof(char*)*nx + sizeof(char)*nx*ny);
    for(i=0;i<nx;i++) 
        currWorld[i] = (char*)(currWorld+nx) + i*ny;
    
    nextWorld = (char**)malloc(sizeof(char*)*nx + sizeof(char)*nx*ny);
    for(i=0;i<nx;i++) 
        nextWorld[i] = (char*)(nextWorld+nx) + i*ny;
    
    /* Initialize boundaries */
    for(i=0;i<nx;i++) {
        currWorld[i][0]=0;
        currWorld[i][ny-1]=0;
        nextWorld[i][0]=0;
        nextWorld[i][ny-1]=0;
    }
    for(i=0;i<ny;i++) {
        currWorld[0][i]=0;
        currWorld[nx-1][i]=0;
        nextWorld[0][i]=0;
        nextWorld[nx-1][i]=0;
    }

    /* Generate initial world - Master thread only */
    if (game == 0) {
        for(i=1;i<nx-1;i++)
            for(j=1;j<ny-1;j++) {
                currWorld[i][j] = (real_rand() < prob);
                population[w_plot] += currWorld[i][j];
            }
    }
    else if (game == 1) {
        printf("2x2 Block, still life\n");
        int nx2 = nx/2;
        int ny2 = ny/2;
        currWorld[nx2+1][ny2+1] = currWorld[nx2][ny2+1] = 
        currWorld[nx2+1][ny2] = currWorld[nx2][ny2] = 1;
        population[w_plot] = 4;
    }
    else if (game == 2) {
        printf("Glider (spaceship)\n");
        int nx2 = nx/2;
        int ny2 = ny/2;
        currWorld[nx2][ny2+1] = 1;
        currWorld[nx2+1][ny2+2] = 1;
        currWorld[nx2+2][ny2] = 1;
        currWorld[nx2+2][ny2+1] = 1;
        currWorld[nx2+2][ny2+2] = 1;
        population[w_plot] = 5;
    }
    else {
        printf("Unknown game %d\n",game);
        exit(-1);
    }
    
    printf("probability: %f\n",prob);
    printf("Random # generator seed: %d\n", rs);
    printf("Number of threads: %d\n", numthreads);

    if(!disable_display)
        MeshPlot(0,nx,ny,currWorld);
    
    omp_init_lock(&plot_lock);
    double t0 = getTime();

    /* Parallel region with task + data parallelism */
    #pragma omp parallel
    {
        int tid = omp_get_thread_num();
        int nthreads = omp_get_num_threads();
        
        /* Thread 0 handles plotting (task parallelism) */
        if (tid == 0 && !disable_display) {
            for(int t=0; t<maxiter && population[w_plot]; t++) {
                /* Wait for computation to complete */
                #pragma omp barrier
                
                /* Plot the current state */
                MeshPlot(t, nx, ny, currWorld);
                
                if (s_step) {
                    printf("Finished with step %d\n",t);
                    printf("Press enter to continue.\n");
                    getchar();
                }
                
                #pragma omp barrier
            }
        }
        /* All threads participate in computation (data parallelism) */
        else {
            int compute_threads = disable_display ? nthreads : nthreads - 1;
            int worker_id = disable_display ? tid : tid - 1;
            
            if (tid > 0 || disable_display) {
                /* 1D domain decomposition */
                int rows_per_thread = (nx-2) / compute_threads;
                int start_row = 1 + worker_id * rows_per_thread;
                int end_row = (worker_id == compute_threads-1) ? nx-1 : start_row + rows_per_thread;
                
                for(int t=0; t<maxiter && population[w_plot]; t++) {
                    int local_pop = 0;
                    
                    /* Compute updates for assigned rows */
                    for(int i=start_row; i<end_row; i++) {
                        for(int j=1; j<ny-1; j++) {
                            int nn = currWorld[i+1][j] + currWorld[i-1][j] + 
                                     currWorld[i][j+1] + currWorld[i][j-1] + 
                                     currWorld[i+1][j+1] + currWorld[i-1][j-1] + 
                                     currWorld[i-1][j+1] + currWorld[i+1][j-1];
                            
                            nextWorld[i][j] = currWorld[i][j] ? (nn == 2 || nn == 3) : (nn == 3);
                            local_pop += nextWorld[i][j];
                        }
                    }
                    
                    /* Atomic update of population */
                    #pragma omp atomic
                    population[w_update] += local_pop;
                    
                    #pragma omp barrier
                    
                    /* Single thread swaps pointers and updates population */
                    #pragma omp single
                    {
                        tmesh = nextWorld;
                        nextWorld = currWorld;
                        currWorld = tmesh;
                        
                        int tmp = w_update;
                        w_update = w_plot;
                        w_plot = tmp;
                        population[w_update] = 0;
                    }
                    
                    #pragma omp barrier
                }
            }
        }
    }
    
    double t1 = getTime();
    printf("Running time for the iterations: %f sec.\n",t1-t0);
    printf("Final population: %d\n", population[w_plot]);
    printf("Press enter to end.\n");
    getchar();
    
    omp_destroy_lock(&plot_lock);
    
    if(gnu != NULL)
        pclose(gnu);
    
    free(nextWorld);
    free(currWorld);

    return(0);
}